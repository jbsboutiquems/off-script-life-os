# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---- Off*Script Life OS server auth config (all optional) ----

# Google OAuth login: GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET from a
# Google Cloud "OAuth client ID (Web application)". Register the redirect URI:
#   <BASE_URL>/api/auth/oauth/google/callback
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# Facebook login: FACEBOOK_APP_ID + FACEBOOK_APP_SECRET from Meta for Developers.
# Register the redirect URI:
#   <BASE_URL>/api/auth/oauth/facebook/callback
#FACEBOOK_APP_ID=
#FACEBOOK_APP_SECRET=

# SMTP for email verification + password reset. Without these, email accounts
# still work but are auto-verified and recovery falls back to the recovery code.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM="Off*Script Life OS <no-reply@example.com>"

# Public base URL used in email links. Defaults to the request host.
#BASE_URL=https://your-domain.example

# Dev/test only:
#OAUTH_DEV_STUB=1            # skip real OAuth, return a fake profile
#SMTP_STUB_CAPTURE=/tmp/lifeos-emails.jsonl   # write outgoing mail to a file
